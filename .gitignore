# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv
ENV/
*.egg-info/
dist/
build/

# Jupyter Notebook
.ipynb_checkpoints

# Data files (large) - but keep 10percent data
# Exclude from root only
/*.csv
/*.xlsx
/*.xls
/*.gpkg
/*.json
/*.geojson

# Keep data in 10percent folder (except large files)
!10percent/*.csv

# Exclude large CSV files (>50MB) that exceed GitHub limits
10percent/zbp_real_data.csv
10percent/industry_by_zip_all.csv
10percent/cache_zbp_data.csv
10percent/premium_flights_analysis.csv
10percent/premium_flights_with_local_time.csv
10percent/corporate_all_zips.csv

# Exclude flights data folder (very large CSV files - raw data)
flights an/

# Exclude other large data folders
traffic_data/
cross_section_analytics/
paper/
publish_web/

# Keep only processed/aggregated data needed for dashboard
!10percent/top10_richest_data.csv
!10percent/top10_corporate_data.csv
!10percent/intersection_analysis.csv
!10percent/intersection_by_city.csv
!10percent/corporate_by_city_summary.csv

# Backup folders
BACKUP_*/

# Cache files
cache_*.json
cache_*.csv
cache_*.gpkg

# Output files (generated) - but keep 10percent images
# Exclude images from root only, keep 10percent folder images
/*.png
/*.jpg
/*.jpeg

# Keep important HTML files
!METHODOLOGY.html
!dashboard_integrated.html
!index.html

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log

